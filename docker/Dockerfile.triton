# Triton image extended with:
#   - Python deps for the tts_frontend backend (text normalization + G2P)
#   - build toolchain + Triton backend headers for compiling tts_stream (C++)
#
#   docker build -f docker/Dockerfile.triton -t tts-triton:dev .
ARG TRITON_VERSION=24.08
FROM nvcr.io/nvidia/tritonserver:${TRITON_VERSION}-py3

ARG TRITON_VERSION
ENV DEBIAN_FRONTEND=noninteractive

# --- build deps for the custom C++ backend ---------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake git rapidjson-dev libb64-dev zlib1g-dev pkg-config \
      libsndfile1 sox \
 && rm -rf /var/lib/apt/lists/*

# --- python deps used by the tts_frontend python backend -------------------
# Kept deliberately thin: this runs once per utterance, off the hot path, but it still
# lives in the serving container so it must not drag in torch.
RUN pip3 install --no-cache-dir \
      numpy \
      phonemizer==3.2.1 \
      inflect==7.3.1 \
      unidecode==1.3.8

# espeak-ng is phonemizer's backend for English G2P
RUN apt-get update && apt-get install -y --no-install-recommends espeak-ng \
 && rm -rf /var/lib/apt/lists/*
ENV PHONEMIZER_ESPEAK_LIBRARY=/usr/lib/x86_64-linux-gnu/libespeak-ng.so.1

# --- Triton backend SDK sources, pinned to the server version --------------
# Needed to compile tts_stream against the matching ABI.
ENV TRITON_BRANCH=r${TRITON_VERSION}
WORKDIR /opt/triton-src
RUN git clone --depth 1 -b ${TRITON_BRANCH} https://github.com/triton-inference-server/backend.git && \
    git clone --depth 1 -b ${TRITON_BRANCH} https://github.com/triton-inference-server/core.git && \
    git clone --depth 1 -b ${TRITON_BRANCH} https://github.com/triton-inference-server/common.git

WORKDIR /workspace
COPY backends/ /workspace/backends/

# Build the streaming backend. Kept as a separate script so it can be re-run
# inside a live container during iteration without rebuilding the image.
COPY scripts/build_backend.sh /usr/local/bin/build_backend.sh
RUN chmod +x /usr/local/bin/build_backend.sh

EXPOSE 8000 8001 8002
