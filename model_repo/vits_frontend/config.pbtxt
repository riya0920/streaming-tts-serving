name: "vits_frontend"
backend: "python"

# Batching ON.
#
# The first version disabled it because token sequences are ragged. That was the single
# largest mistake in the serving config: M9 showed this stage is 100% of the latency tail
# (p99 1000ms while every other stage stays under 20ms), and M2 showed the model is
# launch-bound, which is exactly the regime where batching costs almost nothing. Eight
# instances each doing a batch-1 forward were contending for one GPU to no benefit.
#
# Raggedness is handled rather than avoided: the gateway buckets token lengths to
# multiples of 16 so requests batch together, attention_mask marks the padding, and
# NUM_FRAMES carries each item's true latent length back out.
#
# max_queue_delay is 2ms: M2 measured free batching ending around B=4-8, so the window
# only needs to be long enough to collect a handful of requests. A longer window would
# buy negligible throughput and spend real latency.
max_batch_size: 16

dynamic_batching {
  max_queue_delay_microseconds: 2000
  preferred_batch_size: [ 4, 8 ]
}

input [
  {
    name: "INPUT_IDS"
    data_type: TYPE_INT64
    dims: [ -1 ]
  },
  {
    name: "ATTENTION_MASK"
    data_type: TYPE_INT64
    dims: [ -1 ]
    optional: true
  }
]

output [
  {
    name: "LATENTS"
    data_type: TYPE_FP32
    dims: [ 192, -1 ]
  },
  {
    name: "NUM_FRAMES"
    data_type: TYPE_INT32
    dims: [ 1 ]
  }
]

# Two instances on separate CUDA streams: while one is in a kernel, the other can be
# dispatching. M2 showed this model is launch-bound, so overlapping dispatch with
# execution is exactly the win available here.
# THREE instances, chosen by measurement — more made it worse.
#
# Swept 2 (unbatched), 3 (batched) and 8 (batched). Best p99 at every level below 8 was
# 3 instances with batching; 8 instances with batching was worse everywhere
# (p99 at 4 sessions: 144ms with three, 164ms with eight).
#
# The reason is that instances and batching pull against each other here. Spreading
# arrivals across 8 instances means the 2ms queue window almost never collects a second
# request, so no batch ever forms, and 8 processes then contend for one GPU. Fewer
# instances concentrate arrivals enough for batching to actually fire.
#
# At the knee the GPU sits at ~2% of its throughput ceiling (aggregate RTF 4.7 against
# 207), so this stage is latency-bound, not throughput-bound: what limits concurrency is
# the ~100ms of mostly-serial work per request, not the device.
instance_group [
  {
    count: 3
    kind: KIND_GPU
    gpus: [ 0 ]
  }
]

parameters {
  key: "model_dir"
  value: { string_value: "/workspace/models/facebook__mms-tts-eng" }
}
parameters {
  key: "noise_scale"
  value: { string_value: "0.667" }
}
parameters {
  key: "noise_scale_duration"
  value: { string_value: "0.8" }
}
parameters {
  key: "speaking_rate"
  value: { string_value: "1.0" }
}
