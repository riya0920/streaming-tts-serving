name: "tts_stream"
backend: "tts_stream"

# THE feature this whole architecture depends on.
#
# A normal Triton model is one request, one response. Decoupled mode lets a single
# request emit a stream of responses over time — which is exactly the shape of streaming
# TTS: send text once, get audio chunks flowing back. Without it, streaming has to be
# bolted on top of a request/response server, and time-to-first-audio stays tied to
# utterance length no matter how the model is optimized.
model_transaction_policy {
  decoupled: true
}

# Batching off at this level. The backend is fed one utterance's latents and emits that
# utterance's chunks; batching across sessions happens inside the decoder engine, whose
# profile has an opt batch of 8 (from the M2 probe, where free batching ends).
max_batch_size: 0

input [
  {
    name: "LATENTS"
    data_type: TYPE_FP32
    dims: [ 1, 192, -1 ]
  }
]

output [
  {
    name: "AUDIO_CHUNK"
    data_type: TYPE_INT16
    dims: [ 1, -1 ]
  },
  {
    name: "CHUNK_INDEX"
    data_type: TYPE_INT32
    dims: [ 1, 1 ]
  },
  {
    name: "IS_FINAL"
    data_type: TYPE_BOOL
    dims: [ 1, 1 ]
  }
]

# Two instances on separate CUDA streams: one dispatches while the other executes. M2
# measured this model as launch-bound, so overlapping dispatch with execution is the
# specific win available.
instance_group [
  {
    count: 4
    kind: KIND_GPU
    gpus: [ 0 ]
  }
]

parameters {
  key: "engine_path"
  value: { string_value: "/workspace/models/engines/vits_decoder_fp16.plan" }
}
parameters {
  key: "input_tensor"
  value: { string_value: "latents" }
}
parameters {
  key: "output_tensor"
  value: { string_value: "waveform" }
}

# Every value below is measured, not chosen. See docs/PROFILE.md and results/m3_sweep.json.

# 12 frames = 192 ms. Only the first chunk sets TTFA.
parameters {
  key: "first_chunk_frames"
  value: { string_value: "12" }
}
# 50 frames = 800 ms. Growing after the first chunk drops the overlap tax from 68% to 34%.
parameters {
  key: "max_chunk_frames"
  value: { string_value: "50" }
}
parameters {
  key: "chunk_growth"
  value: { string_value: "2.0" }
}
# The decoder's measured effective receptive field. Below 11 the seams click audibly
# (seam SNR 5.1 dB at 8, 31.4 dB at 11); above 13 costs waste for nothing.
parameters {
  key: "overlap_frames"
  value: { string_value: "13" }
}
# Product of the generator's upsample_rates for this checkpoint — samples per latent frame.
parameters {
  key: "hop"
  value: { string_value: "256" }
}
parameters {
  key: "channels"
  value: { string_value: "192" }
}
