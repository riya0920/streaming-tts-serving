name: "tts_frontend"
backend: "python"

# Batching is OFF, deliberately.
#
# Token sequences are ragged, and Triton's dynamic batcher requires matching non-batch
# dimensions, so batching here would mean padding every request to the longest in the
# batch and carrying the waste through. This stage is pure CPU string work that runs once
# per utterance and costs single-digit milliseconds — there is nothing to gain.
#
# Concurrency comes from instances instead, which is the right lever for CPU-bound work.
max_batch_size: 0

input [
  {
    name: "TEXT"
    data_type: TYPE_STRING
    dims: [ 1 ]
  }
]

output [
  {
    name: "INPUT_IDS"
    data_type: TYPE_INT64
    dims: [ 1, -1 ]
  },
  {
    name: "ATTENTION_MASK"
    data_type: TYPE_INT64
    dims: [ 1, -1 ]
  },
  {
    name: "NORMALIZED_TEXT"
    data_type: TYPE_STRING
    dims: [ 1 ]
  }
]

# CPU-only: this stage never touches the GPU, and pinning it off-device keeps it from
# competing with the decoder for anything.
instance_group [
  {
    count: 8
    kind: KIND_CPU
  }
]

parameters {
  key: "tokenizer_dir"
  value: { string_value: "/workspace/models/facebook__mms-tts-eng" }
}
parameters {
  key: "max_chars"
  value: { string_value: "2000" }
}

# The python backend spawns a stub process per instance; give it room for transformers.
parameters {
  key: "FORCE_CPU_ONLY_INPUT_TENSORS"
  value: { string_value: "yes" }
}
